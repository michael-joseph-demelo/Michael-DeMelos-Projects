# Copy this file to ".env" (same folder) and paste your real key after the "=".
# Get a key at https://console.anthropic.com -> API Keys.
# Never share your .env file or commit it to Git.
ANTHROPIC_API_KEY=

# Optional: your Godot project folder, so you don't have to type it every time.
GODOT_PROJECT_DIR=

# Optional: where your design docs live (default: a "docs" folder inside the project).
DESIGN_DOCS_DIR=
